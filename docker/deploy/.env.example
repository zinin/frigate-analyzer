# Database (external PostgreSQL)
DB_HOST=192.168.1.100
DB_PORT=5432
DB_NAME=frigate_analyzer
DB_USER=frigate_analyzer_rw
DB_PASS=secret

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_OWNER=your-username

# Paths
FRIGATE_RECORDS_FOLDER=/mnt/data/frigate/recordings

# --- Records watcher ---
# The one-off startup scan that indexes recordings already on disk is DISABLED by default.
# Set to false to run the backfill once (first install, index recovery) — read FIRST_SCAN_PERIOD first.
# CONSEQUENCE: while the scan is disabled, recordings written during a period when the application
# was DOWN are never indexed at all — the watcher only sees files created after it registers.
# To recover such a gap: set DISABLE_FIRST_SCAN=false AND size FIRST_SCAN_PERIOD by the number of
# UTC dates the outage straddles, not its length in hours (P1D = today and yesterday), restart,
# wait for the "Finish first time scan task" line, then revert BOTH variables and restart again.
# A "First scan found nothing" WARN instead means the volume is not mounted and NOTHING was
# recovered — fix the mount and repeat before reverting the variables.
# The backfill feeds that whole window through the detection pipeline and therefore through
# Telegram, so every recording in it that yields a detection produces a notification.
# DISABLE_FIRST_SCAN=true
# How far back the watcher registers directories. Whole days in UTC, at least P1D.
# WATCH_PERIOD=P1D
# How far back the startup scan indexes files. Defaults to WATCH_PERIOD truncated to whole days, so
# raising WATCH_PERIOD widens the startup backfill too — but only across a whole-day boundary
# (PT36H still yields P1D here, widening neither window). Whole days in UTC; P0D = today only, and
# a sub-day value set here fails at startup rather than being truncated (WATCH_PERIOD itself must
# stay at least P1D). Every indexed file becomes a recording and is fed to the detection pipeline,
# so keep it small: P1D is today AND yesterday, which at three cameras and 10-second segments
# (8 640 files per camera per day) is about 52 000 files. The whole list is held in memory before
# processing — roughly 200 bytes per file, so ~10 MB at P1D but ~150 MB at P30D. Windows wider than
# P7D log a WARN saying so when the scan starts; there is no hard upper limit, because recovering a
# long outage is a legitimate reason to widen it.
# FIRST_SCAN_PERIOD=P1D
# How often expired watch keys are cleaned up (ISO-8601 duration).
# WATCH_CLEANUP_INTERVAL=PT1H

# --- Actuator ---
# Expose /actuator/health details: always | never | when-authorized. `always` shows the failure
# reason, the NUMBER of registered directories, timestamps and the text of the last error to anyone
# who can reach the published port — that error text usually carries the path it failed on, and
# Spring's own diskSpace contributor also publishes a filesystem path of its own — the JVM
# working directory (/application in this image), not the data directory.
# Spring's relaxed binding also honours
# MANAGEMENT_ENDPOINT_HEALTH_SHOWDETAILS — set only one of the two.
# HEALTH_SHOW_DETAILS=always

# Host port mapping (internal container port is always 8080)
HOST_PORT=8080

# Logging
LOG_LEVEL=info
APP_LOG_LEVEL=info

# Docker image version (use specific version for reproducible deploys)
IMAGE_TAG=latest

# --- AI descriptions (optional) ---
# Enables Claude-generated short + detailed descriptions of detection frames.
# Comments are placed above each variable (not inline) so the line is safe to uncomment —
# env_file parsers (docker compose, systemd EnvironmentFile) do NOT treat `#` as an inline
# comment and would otherwise bake the text into the value.
# APP_AI_DESCRIPTION_ENABLED=true
# Provider: claude | grok. Each has its own block below.
# APP_AI_DESCRIPTION_PROVIDER=claude
# Language for AI descriptions: ru | en (validated at startup via @Pattern).
# APP_AI_DESCRIPTION_LANGUAGE=en
# APP_AI_DESCRIPTION_SHORT_MAX=200
# APP_AI_DESCRIPTION_DETAILED_MAX=1500
# Top-N frames by detection quality (max confidence, then detection count) — same ranking
# as the user-visible media group, so Claude describes exactly what the user receives.
# APP_AI_DESCRIPTION_MAX_FRAMES=10
# Waiting-for-semaphore-permit budget (before describe() starts).
# APP_AI_DESCRIPTION_QUEUE_TIMEOUT=30s
# Total budget for describe + retry (after the semaphore permit is acquired).
# APP_AI_DESCRIPTION_TIMEOUT=60s
# APP_AI_DESCRIPTION_MAX_CONCURRENT=2

# --- Claude-specific (when provider=claude) ---
# Obtain the token ONCE on the host: `claude setup-token`,
# copy the value here. Long-lived OAuth token (works against your Claude subscription).
# CLAUDE_CODE_OAUTH_TOKEN=
# Model alias: opus | sonnet | haiku (resolved to current version by the CLI).
# CLAUDE_MODEL=opus
# Empty = SDK resolves via `which claude`. Non-empty = explicit binary path.
# CLAUDE_CLI_PATH=
# Empty = uses application.temp-folder (required for SDK).
# CLAUDE_WORKING_DIR=
# Max size of one JSON message from the CLI (Spring DataSize: 16MB, 32MB, ...). The CLI echoes
# every frame the model reads back as base64, so the SDK's own 1 MiB default already overflows
# on a ~750 KB frame; raise this for cameras whose frames exceed ~12 MB.
# CLAUDE_MAX_BUFFER_SIZE=16MB

# --- Optional Anthropic-compatible provider overrides ---
# When set, CLAUDE_CODE_OAUTH_TOKEN is not required.
# Allows routing Claude CLI requests through alternative providers
# (e.g., Alibaba DashScope, local proxy, etc.).
# At least one of CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_AUTH_TOKEN is required.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://example.com/apps/anthropic
# ANTHROPIC_MODEL=<model-name>
# ANTHROPIC_DEFAULT_OPUS_MODEL=<model-name>
# ANTHROPIC_DEFAULT_SONNET_MODEL=<model-name>
# ANTHROPIC_DEFAULT_HAIKU_MODEL=<model-name>

# --- Optional proxy for Claude API calls ---
# CLAUDE_HTTP_PROXY=http://proxy:8080
# CLAUDE_HTTPS_PROXY=http://proxy:8080
# CLAUDE_NO_PROXY=localhost,127.0.0.1

# --- Grok-specific (when provider=grok) ---
# Grok Build (https://x.ai/cli) signs in with your SuperGrok subscription; no API key is needed.
# First start: on the host `mkdir -p grok-home && sudo chown 1000:1000 grok-home`, then
# `docker compose up -d` and `docker compose exec frigate-analyzer grok login --device-code`.
# grok-home/auth.json refreshes itself afterwards. Never copy auth.json from another machine:
# the refresh token rotates and only one copy survives. The owner gets a Telegram message if the
# credentials stop working, with the command to run.
# Model id, or the name of a [model.<name>] BYOK entry from grok-home/config.toml.
# GROK_MODEL=grok-4.6
# Reasoning effort: low | medium | high | xhigh. Empty = the flag is not passed (BYOK models without
# reasoning levels).
# GROK_EFFORT=low
# Empty = `grok` from PATH. Non-empty = explicit binary path.
# GROK_CLI_PATH=
# Grok home on the persistent volume (auth.json, config.toml, sessions). docker-compose.yml sets it;
# keep both in sync if you change it.
# GROK_HOME=/application/grok-home
# Empty directory Grok runs in. Empty = <TEMP_FOLDER>/grok-cwd.
# GROK_WORKING_DIR=
# BYOK example, in grok-home/config.toml:
#   [model.my-vision]
#   model = "my-vision-model"
#   base_url = "https://gateway.example.com/v1"
#   env_key = "MY_GATEWAY_KEY"
# then GROK_MODEL=my-vision, GROK_EFFORT= (empty) and MY_GATEWAY_KEY=... in this file.

# --- Optional proxy for Grok API calls ---
# GROK_HTTP_PROXY=http://proxy:8080
# GROK_HTTPS_PROXY=http://proxy:8080
# GROK_NO_PROXY=localhost,127.0.0.1

# --- Notification tracker (object tracking + suppression) ---
# At this TTL nothing can ever reappear: the gap below defaults to TTL, and an absence has to exceed
# the gap. REAPPEAR_CLASSES and COOLDOWN_REAPPEAR further down are therefore inert until TTL is
# raised — and raising the gap alone, above TTL, fails the `reappear-gap <= ttl` check at startup.
NOTIFICATIONS_TRACK_TTL=PT2M
NOTIFICATIONS_TRACK_IOU_THRESHOLD=0.3
NOTIFICATIONS_TRACK_INNER_IOU=0.5
NOTIFICATIONS_TRACK_CONFIDENCE_FLOOR=0.3
NOTIFICATIONS_TRACK_CLEANUP_INTERVAL_MS=3600000
NOTIFICATIONS_TRACK_CLEANUP_RETENTION=PT1H
# Absence after which a matched track notifies again as REAPPEARED. Must be > 0 and <= TTL.
# Left unset it equals TTL, which disables reappearance notifications entirely — only worth
# setting under a long TTL. See .claude/rules/configuration.md for how to pick a value.
# NOTIFICATIONS_TRACK_REAPPEAR_GAP=PT1H

# Classes allowed to notify when they come *back*. Empty (the default) = all of them. Narrowing
# this leaves first-time appearances alone: "a new cow" still notifies, "the cow is back" stops.
# Unrelated to DETECTION_FILTER_CLASSES, which decides what is detected at all.
# NOTIFICATIONS_TRACK_REAPPEAR_CLASSES=person

# --- Notification cooldown ---
# Minimum distance between two REAPPEARED notifications for one camera, measured on recording
# time (not the wall clock, so a backlog spanning more than the cooldown is not collapsed into a
# single notification). PT0S (the default) disables it.
# One pass through a frame full of stale tracks matches several of them in a row and each match
# is its own reappearance; this collapses that burst into one notification per camera.
# The window is per camera and class-agnostic — whatever reappears first arms it for every class on
# that camera, so set it together with NOTIFICATIONS_TRACK_REAPPEAR_CLASSES above.
# NOTIFICATIONS_COOLDOWN_REAPPEAR=PT5M
